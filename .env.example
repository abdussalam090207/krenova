# Salin file ini ke .env.local dan isi nilainya dari Supabase Dashboard → Project Settings → API
# Jangan commit .env.local ke Git.

# URL project Supabase (boleh publik)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / publishable key (boleh publik — BUKAN service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Mode data: "supabase" (default), "dummy" (tampilkan data dummy tanpa DB), atau "none" (layar kosong)
# Di Production Vercel WAJIB diisi "supabase" atau dikosongkan (default supabase)
NEXT_PUBLIC_DATA_MODE=supabase

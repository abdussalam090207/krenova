# Salin file ini ke .env.local dan isi nilainya.
# Jangan commit .env.local ke Git.

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_DATA_MODE=supabase

# ===== Katalog (server-side, RAHASIA) =====
SUPABASE_SERVICE_ROLE_KEY=             # Settings → API Keys → service_role
MIDTRANS_SERVER_KEY=                   # SB-Mid-server-... (sandbox dulu)
MIDTRANS_IS_PRODUCTION=false           # "true" HANYA saat go-live
RESEND_API_KEY=                        # dari dashboard Resend
EMAIL_FROM=KRENOVA STUDIO <noreply@krenovas.my.id>
ADMIN_NOTIFY_EMAIL=krenovastudio26@gmail.com
NEXT_PUBLIC_SITE_URL=https://krenovas.my.id
CATALOG_SECRET=                        # node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ===== Cloudflare R2 (SEMUA RAHASIA KECUALI URL PUBLIK) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=catalog-media
R2_PRIVATE_BUCKET_NAME=catalog-private
NEXT_PUBLIC_R2_PUBLIC_URL=            # URL publik bucket catalog-media (r2.dev sementara, domain kustom di produksi), tanpa slash di akhir

# ===== Admin API =====
ADMIN_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500   # origin Web admin; tanpa wildcard
